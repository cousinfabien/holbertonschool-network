#!/usr/bin/env bash
# Ce script configure le fichier /etc/hosts pour rediriger localhost et facebook.com sans planter sur Docker

# 1. On copie le fichier /etc/hosts actuel dans un fichier temporaire
cp /etc/hosts /tmp/hosts.tmp

# 2. On fait les modifications avec sed dans notre fichier temporaire (ici pas de blocage Docker)
sed -i 's/127.0.0.1\tlocalhost/127.0.0.2\tlocalhost/g' /tmp/hosts.tmp
sed -i 's/127.0.0.1 localhost/127.0.0.2 localhost/g' /tmp/hosts.tmp

# 3. Si facebook.com n'est pas déjà présent, on l'ajoute au fichier temporaire
if ! grep -q "facebook.com" /tmp/hosts.tmp; then
    echo -e "8.8.8.8\tfacebook.com" >> /tmp/hosts.tmp
else
    # S'il y est, on met à jour son IP
    sed -i 's/.*facebook.com/8.8.8.8\tfacebook.com/g' /tmp/hosts.tmp
fi

# 4. On écrase proprement le vrai /etc/hosts avec le contenu modifié
cat /tmp/hosts.tmp > /etc/hosts

# 5. Nettoyage du fichier temporaire
rm /tmp/hosts.tmp
